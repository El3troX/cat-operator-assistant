# Copy to backend/.env to override defaults. Every setting is optional;
# real environment variables take precedence over this file.

# SQLAlchemy URL. Default: sqlite database at backend/cat_assistant.db
# DATABASE_URL=sqlite:///C:/path/to/cat_assistant.db

# Browser origins allowed to call the API, comma-separated (e.g. a deployed frontend).
# CORS_ORIGINS=https://operator-assist.example.com

# Regex of allowed origins. Default allows any localhost/127.0.0.1 port for local dev.
# Set it empty in production so only CORS_ORIGINS are allowed.
# CORS_ORIGIN_REGEX=

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# One JSON object per log line, for log aggregators.
# LOG_JSON=false

# Live telemetry: replays operation_log over /ws/telemetry with simulated ground
# workers, and raises proximity alerts when one walks inside 2 m.
# SIM_ENABLED=true
# SIM_INTERVAL_S=2.0
# SIM_SEED=7

# Voice co-pilot (Claude with tool use). Without a key it answers with its offline
# keyword commands. Keep the real key only in backend/.env, which is git-ignored.
# ANTHROPIC_API_KEY=
# claude-opus-5 by default; claude-haiku-4-5 answers faster for a live demo.
# COPILOT_MODEL=claude-opus-5
# low | medium | high (ignored for Haiku)
# COPILOT_EFFORT=low
# COPILOT_TIMEOUT_S=20
